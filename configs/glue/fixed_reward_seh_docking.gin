# Fixed-reward (single-shot) RGFN on sEH GPU docking.
#
# Mirrors the RGFN paper's docking benchmark (`[koziarski2024rgfn]` §4.1): train the GFN
# ONCE with QuickVina2-GPU docking called DIRECTLY as the reward every step — a reward
# generator that is NOT a surrogate (the paper's argument: docking-in-the-loop eliminates
# proxy generalization failure). No active-learning loop, no oracle. This is RGFN test #2.
#
# We `include` the upstream paper config unchanged (base + docking reaction env +
# `DockingMoleculeProxy(receptor='sEH')`, beta=4, Trainer.n_iterations=400 ≈ 18h — Patch #3)
# and overlay only the fixed-reward pipeline wiring.
include 'configs/rgfn_seh_docking.gin'

# Make the Trainer a singleton so the pipeline and the trainer's reward share ONE
# instance (both reference %train_proxy = the docking proxy singleton).
trainer/gin.singleton.constructor = @Trainer
trainer = @trainer/gin.singleton()

# The fixed-reward pipeline. reward_generator is the SAME docking proxy the reward uses.
# n_samples is kept modest: scoring the final batch re-docks any molecule not already
# cached from training, so we bound the post-training docking cost.
FixedRewardPipeline.trainer = %trainer
FixedRewardPipeline.reward_generator = %train_proxy
FixedRewardPipeline.n_samples = 200
FixedRewardPipeline.sample_oversample = 6.0
FixedRewardPipeline.top_k = 100
FixedRewardPipeline.system = 'seh'
FixedRewardPipeline.generator_name = 'rgfn'
FixedRewardPipeline.reward_name = 'seh_docking'
FixedRewardPipeline.score_units = 'docking_proxy_reward (higher is better; normalized -Vina)'
