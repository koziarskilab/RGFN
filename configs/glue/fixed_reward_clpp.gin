# Fixed-reward (single-shot) RGFN on ClpP GPU DOCKING (single target).
#
# Trains the GFN ONCE with QuickVina2-GPU docking against ClpP (caseinolytic protease P, one
# of the RGFN paper's benchmark docking targets; configs/rgfn_clpp_docking.gin) called
# DIRECTLY as the reward every training step. Like the 6TD3 differential run, the reward is
# exposed through the generic OracleRewardProxy adapter wrapping DockingClpPOracle — so the
# raw Vina energy (lower-is-better) becomes a non-negative higher-is-better reward via
# clip(-vina/norm, 0, inf) AND torch's GPU cache is freed before each dock so QuickVina2-GPU
# is not starved during training (Logs/014; the likely cause of the prior sEH-docking failure
# job 69567, which used the raw DockingMoleculeProxy without that guard). No AL loop, no oracle.
#
# Run:  python scripts/fixed_reward.py --cfg configs/glue/fixed_reward_clpp.gin --seed 42
# (Balam compute node only: needs a GPU + QuickVina2-GPU + data/targets/ClpP.pdbqt.)

include 'configs/rgfn_base.gin'
include 'configs/envs/reaction_docking.gin'   # docking-capable reaction env (max_num_reactions=4)

# --- Reward generator: ClpP single-target docking wrapped as a GFN reward ---------------
proxy/gin.singleton.constructor = @OracleRewardProxy
train_proxy = @proxy/gin.singleton()
valid_proxy = %train_proxy
OracleRewardProxy.oracle = @DockingClpPOracle()
OracleRewardProxy.norm = 1.0
OracleRewardProxy.free_gpu_cache = True

beta = 4   # docking-reward inverse temperature (matches rgfn_clpp_docking.gin)

# --- Shared SMALL library (glue_standard_v1) via GlueReactionDataFactory -----------------
data_factory/gin.singleton.constructor = @GlueReactionDataFactory
GlueReactionDataFactory.library_dir = 'data/libraries/glue_standard_v1'
GlueReactionDataFactory.docking = True

Trainer.n_iterations = 400   # docking-in-the-loop cap (~16h at 400 iters; benchmark 69691)

train_metrics = [@StandardGFNMetrics(), @FractionEarlyTerminate(), @UniqueMolecules()]

# --- Fixed-reward pipeline wiring --------------------------------------------------------
trainer/gin.singleton.constructor = @Trainer
trainer = @trainer/gin.singleton()
FixedRewardPipeline.trainer = %trainer
FixedRewardPipeline.reward_generator = %train_proxy
FixedRewardPipeline.n_samples = 200
FixedRewardPipeline.sample_oversample = 6.0
FixedRewardPipeline.top_k = 100
FixedRewardPipeline.system = 'clpp'
FixedRewardPipeline.generator_name = 'rgfn'
FixedRewardPipeline.reward_name = 'clpp_docking'
FixedRewardPipeline.score_units = 'clip(-vina) reward (higher is better; raw Vina kcal/mol in raw_score column)'
