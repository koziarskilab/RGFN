# Fixed-reward (single-shot) RGFN on the pretrained sEH proxy.
#
# Mirrors the RGFN paper's sEH benchmark (`[koziarski2024rgfn]` §4): train the GFN ONCE
# against the frozen Bengio-2021 sEH MPNN — a *surrogate* reward generator standing in
# for docking — with NO active-learning loop and NO oracle. This is RGFN test #1 and its
# entry in the matched four-way sEH comparison.
#
# We `include` the upstream paper config unchanged (base + reaction env + `SehMoleculeProxy`,
# beta=8, mode/scaffold metrics) and overlay only the fixed-reward pipeline wiring.
include 'configs/rgfn_seh_proxy.gin'

# Make the Trainer a singleton so the pipeline and the trainer's reward share ONE
# instance (both reference %train_proxy = the sEH proxy singleton).
trainer/gin.singleton.constructor = @Trainer
trainer = @trainer/gin.singleton()

# The fixed-reward pipeline. reward_generator is the SAME frozen sEH proxy the reward
# uses; there is no oracle, no refit, no seed D_0, no rounds.
FixedRewardPipeline.trainer = %trainer
FixedRewardPipeline.reward_generator = %train_proxy
FixedRewardPipeline.n_samples = 1000
FixedRewardPipeline.sample_oversample = 4.0
FixedRewardPipeline.top_k = 100
FixedRewardPipeline.system = 'seh'
FixedRewardPipeline.generator_name = 'rgfn'
FixedRewardPipeline.reward_name = 'seh_proxy'
FixedRewardPipeline.score_units = 'seh_mpnn_reward (higher is better)'
